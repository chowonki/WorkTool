<Application x:Class="WorkTool.WinUI.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
   <!-- 글꼴: Windows 기본(Segoe UI Variable), 한글은 시스템이 맑은 고딕으로 이어 써요 -->
   <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Malgun Gothic</FontFamily>
   <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>
   <ResourceDictionary.ThemeDictionaries>
    <!-- 강조색은 WorkTool 녹색. AccentButton·선택 막대·체크 상자가 모두 이 색을 써요. -->
    <ResourceDictionary x:Key="Light">
     <Color x:Key="SystemAccentColor">#267358</Color>
     <Color x:Key="SystemAccentColorDark1">#267358</Color>
     <Color x:Key="SystemAccentColorDark2">#1F6049</Color>
     <Color x:Key="SystemAccentColorDark3">#174A38</Color>
     <Color x:Key="SystemAccentColorLight1">#2E8A69</Color>
     <Color x:Key="SystemAccentColorLight2">#4FB38C</Color>
     <Color x:Key="SystemAccentColorLight3">#7CCCAA</Color>
     <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FBFBFB"/>
     <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#E5E5E5"/>
     <SolidColorBrush x:Key="WorkDivider" Color="#E5E5E5"/>
     <SolidColorBrush x:Key="WorkRowAlt" Color="#F5F5F5"/>
     <SolidColorBrush x:Key="WorkRowSelected" Color="#E3EFEA"/>
     <SolidColorBrush x:Key="WorkSuccess" Color="#1F7A4D"/>
     <SolidColorBrush x:Key="WorkWarning" Color="#A65A10"/>
     <SolidColorBrush x:Key="WorkDanger" Color="#B42F2F"/>
     <SolidColorBrush x:Key="WorkInfo" Color="#1D4FA8"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <Color x:Key="SystemAccentColor">#4FB38C</Color>
     <Color x:Key="SystemAccentColorDark1">#267358</Color>
     <Color x:Key="SystemAccentColorDark2">#1F6049</Color>
     <Color x:Key="SystemAccentColorDark3">#174A38</Color>
     <Color x:Key="SystemAccentColorLight1">#3E9C78</Color>
     <Color x:Key="SystemAccentColorLight2">#4FB38C</Color>
     <Color x:Key="SystemAccentColorLight3">#7CCCAA</Color>
     <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#272727"/>
     <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#3A3A3A"/>
     <SolidColorBrush x:Key="WorkDivider" Color="#3A3A3A"/>
     <SolidColorBrush x:Key="WorkRowAlt" Color="#2B2B2B"/>
     <SolidColorBrush x:Key="WorkRowSelected" Color="#2F3D37"/>
     <SolidColorBrush x:Key="WorkSuccess" Color="#6CCB98"/>
     <SolidColorBrush x:Key="WorkWarning" Color="#E3A15B"/>
     <SolidColorBrush x:Key="WorkDanger" Color="#F08A8A"/>
     <SolidColorBrush x:Key="WorkInfo" Color="#8AB4F8"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="WorkDivider" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="WorkRowAlt" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="WorkRowSelected" Color="{ThemeResource SystemColorHighlightColor}"/>
     <SolidColorBrush x:Key="WorkSuccess" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="WorkWarning" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="WorkDanger" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="WorkInfo" Color="{ThemeResource SystemColorWindowTextColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
  </ResourceDictionary>
 </Application.Resources>
</Application>
