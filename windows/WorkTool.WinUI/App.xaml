<Application x:Class="WorkTool.WinUI.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
   <!-- 글꼴: 앱에 넣은 Pretendard(설치 없이 같은 모양). 차량목록·원문은 고정폭. -->
   <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/Pretendard-Regular.otf#Pretendard</FontFamily>
   <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Pretendard-Regular.otf#Pretendard</FontFamily>
   <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, ms-appx:///Assets/Fonts/Pretendard-Regular.otf#Pretendard</FontFamily>
   <ResourceDictionary.ThemeDictionaries>
    <!-- 강조색은 WorkTool 녹색. AccentButton·선택 막대·체크 상자가 모두 이 색을 써요. -->
    <ResourceDictionary x:Key="Light">
     <Color x:Key="SystemAccentColor">#267358</Color>
     <Color x:Key="SystemAccentColorDark1">#267358</Color>
     <Color x:Key="SystemAccentColorDark2">#1F6049</Color>
     <Color x:Key="SystemAccentColorDark3">#174A38</Color>
     <Color x:Key="SystemAccentColorLight1">#2E8A69</Color>
     <Color x:Key="SystemAccentColorLight2">#4FB38C</Color>
     <Color x:Key="SystemAccentColorLight3">#7CCCAA</Color>
     <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FBFBFB"/>
     <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#E5E5E5"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <Color x:Key="SystemAccentColor">#4FB38C</Color>
     <Color x:Key="SystemAccentColorDark1">#267358</Color>
     <Color x:Key="SystemAccentColorDark2">#1F6049</Color>
     <Color x:Key="SystemAccentColorDark3">#174A38</Color>
     <Color x:Key="SystemAccentColorLight1">#3E9C78</Color>
     <Color x:Key="SystemAccentColorLight2">#4FB38C</Color>
     <Color x:Key="SystemAccentColorLight3">#7CCCAA</Color>
     <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#272727"/>
     <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#3A3A3A"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
  </ResourceDictionary>
 </Application.Resources>
</Application>
