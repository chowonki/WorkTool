<Window x:Class="WorkTool.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 제목 표시줄과 왼쪽 탐색 창은 Mica, 내용 영역은 #FBFBFB(다크 #272727) 면에 왼쪽 위만 8px 둥글게 (NavigationView 기본 모양) -->
 <Grid x:Name="Root">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="Header" Background="Transparent">
   <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,150,0" VerticalAlignment="Center">
    <Image Source="ms-appx:///Assets/WorkTool.ico" Width="16" Height="16"/>
    <TextBlock Text="WorkTool 업무도구" FontSize="12" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
    PaneDisplayMode="Left" OpenPaneLength="240" IsPaneOpen="True" IsPaneToggleButtonVisible="False"
    IsTitleBarAutoPaddingEnabled="False" SelectionChanged="Navigate">
   <Grid>
    <Grid x:Name="PageHost"/>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" VerticalAlignment="Bottom" HorizontalAlignment="Center"
      MaxWidth="640" Margin="16,0,16,48"/>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
