<Window x:Class="WorkTool.WinUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Header" Background="{ThemeResource LayerFillColorDefaultBrush}">
   <StackPanel Orientation="Horizontal" Spacing="12" Margin="20,0,150,0" VerticalAlignment="Center">
    <FontIcon Glyph="&#xE80F;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    <TextBlock Text="WorkTool" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="업무 도구" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
    PaneDisplayMode="LeftCompact" OpenPaneLength="220" IsPaneOpen="True" SelectionChanged="Navigate">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="홈" Tag="home" Icon="Home"/>
    <NavigationViewItem Content="탁송체크" Tag="dispatch"><NavigationViewItem.Icon><FontIcon Glyph="&#xE804;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="하나은행 이체파일" Tag="transfer" Icon="Switch"/>
    <NavigationViewItem Content="사용 방법" Tag="help" Icon="Help"/>
   </NavigationView.MenuItems>
   <Grid x:Name="PageHost" Padding="28,20,28,12"/>
  </NavigationView>
  <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="12,0,12,8"/>
 </Grid>
</Window>
